# Copy to .env and adjust. Never commit .env.

# PostgreSQL (db service)
POSTGRES_USER=agrowave
POSTGRES_PASSWORD=agrowave
POSTGRES_DB=agrowave
# Host port for PostgreSQL; 5433 avoids clashing with a local PostgreSQL on 5432.
DB_HOST_PORT=5433

# MinIO (minio service)
MINIO_ROOT_USER=agrowave
MINIO_ROOT_PASSWORD=agrowave-secret

# API settings (agrowave.settings.Settings)
DATABASE_URL=postgresql+psycopg://agrowave:agrowave@db:5432/agrowave
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_DEMS=agrowave-dems
S3_ACCESS_KEY=agrowave
S3_SECRET_KEY=agrowave-secret
S3_REGION=us-east-1

# Integration tests only (created and emptied by the pytest fixtures)
TEST_DATABASE_URL=postgresql+psycopg://agrowave:agrowave@db:5432/agrowave_test
TEST_S3_BUCKET_DEMS=agrowave-dems-test
